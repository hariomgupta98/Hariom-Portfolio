<!-- Project details popup -->
<dialog class="case-modal" id="caseModal" aria-labelledby="modalTitle">
  <button class="modal-close" id="modalClose" type="button" aria-label="Close case study">×</button>
  <p class="eyebrow" id="modalKicker">
  </p>
  <h2 id="modalTitle">
  </h2>
  <p class="modal-summary" id="modalSummary">
  </p>
  <div class="modal-grid">
    <div>
      <span>The problem</span>
      <p id="modalProblem">
      </p>
    </div>
    <div>
      <span>The approach</span>
      <p id="modalApproach">
      </p>
    </div>
  </div>
  <div class="tag-list" id="modalTags">
  </div>
</dialog>
