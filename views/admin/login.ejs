<% layout('/layouts/boilerplate') %>
<section class="section container admin-page">
 <p class="eyebrow">Portfolio administration</p><h1>Admin login</h1>
 <p>Sign in to manage your projects.</p>
 <% if(error) { %><p role="alert"><%= error %></p><% } %>
 <form method="POST" action="/admin/login" class="project-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label for="username">Username</label><input id="username" name="username" autocomplete="username" maxlength="50" required>
  <label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" maxlength="1024" required>
  <button class="button button-primary">Sign in</button><a href="/">Back to portfolio</a>
 </form>
</section>
