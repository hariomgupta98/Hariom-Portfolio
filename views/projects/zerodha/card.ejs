<article class="project-card project-featured reveal">
  <a class="project-art art-zerodha" href="<%= project.url || '#projects' %>" target="_blank" rel="noopener" aria-label="Open Zerodha live home page">
    <% if (hasAsset("/projects/zerodha/screenshot.png")) { %>
      <img class="zerodha-screenshot" src="/projects/zerodha/screenshot.png" alt="Zerodha project homepage showing trading dashboards" width="1841" height="905" loading="lazy">
    <% } else { %>
      <span class="asset-note">Zerodha project homepage showing trading dashboards</span>
    <% } %>
  </a>
  <div class="project-content">
    <div class="project-meta">
      <span>02 · Personal project</span>
      <span>Home + Dashboard</span>
    </div>
    <h3><%= project.title %></h3>
    <p><%= project.description %></p>
    <div class="zerodha-links">
      <a class="project-open" href="<%= project.url || '#projects' %>" target="_blank" rel="noopener noreferrer">Live Home Page ↗</a>
      <a class="project-open" href="https://zerodha-dashboard-8rmh.onrender.com" target="_blank" rel="noopener noreferrer">Live Dashboard ↗</a>
      <a class="project-open" href="https://github.com/hariomgupta98/Zerodha" target="_blank" rel="noopener noreferrer">View on GitHub ↗</a>
    </div>
    <% if (project.liveUrl) { %>
  <a class="project-live-link" href="<%= project.liveUrl %>" target="_blank" rel="noopener noreferrer">View live project ↗</a>
<% } %>
  </div>
</article>
