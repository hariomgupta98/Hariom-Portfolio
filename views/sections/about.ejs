      <a href="https://github.com/hariomgupta98" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/hariomgupta2756/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href="https://leetcode.com/u/hgupta9836/" target="_blank" rel="noopener noreferrer">LeetCode ↗</a>
    </nav>
