<section class="container" id="certifications">
  <!-- Google Cloud certificate -->
  <div class="arcade-achievement reveal" aria-labelledby="arcade-title">
    <div class="arcade-copy">
      <p class="eyebrow">Cloud learning · Recognition</p>
      <h2 id="arcade-title">Google Cloud Arcade</h2>
      <p class="arcade-award">Certificate of Excellence</p>
      <p>Achieved <strong>Milestone 4 and Ranger Tier</strong> with <strong>69 points</strong> in the Google Cloud
        Arcade Facilitator Program 2025, Cohort 1.</p>
      <div class="tag-list">
        <span>12 Arcade games</span>
        <span>8 Trivia games</span>
        <span>44 skill badges</span>
        <span>16 lab-free courses</span>
      </div>
      <p class="arcade-date">Program: 1 April–2 June 2025 · Issued: 4 June 2025</p>
      <a class="button button-primary" href="<%= hasAsset("/assets/certificates/arcade-certificate.png")
        ? "/assets/certificates/arcade-certificate.png" : "/assets-help" %>" target="_blank" rel="noopener">View
        certificate <span aria-hidden="true">↗</span>
      </a>
    </div>
    <a class="certificate-preview" href="<%= hasAsset("/assets/certificates/arcade-certificate.png")
      ? "/assets/certificates/arcade-certificate.png" : "/assets-help" %>" target="_blank" rel="noopener"
      aria-label="Open Hariom Gupta’s Google Cloud Certificate of Excellence">
      <% if (hasAsset("/assets/certificates/arcade-certificate.png")) { %>
        <img src="/assets/certificates/arcade-certificate.png"
          alt="Google Cloud Certificate of Excellence awarded to Hariom Gupta for Milestone 4, Ranger Tier, and 69 points, issued 4 June 2025"
          width="491" height="347" loading="lazy">
        <% } else { %>
          <span class="asset-note">Google Cloud Certificate of Excellence awarded to Hariom Gupta for Milestone 4,
            Ranger Tier, and 69 points, issued 4 June 2025</span>
          <% } %>
    </a>
    <div class="arcade-gallery">
      <figure class="arcade-portrait">
        <% if (hasAsset("/assets/images/arcade-moment.jpg")) { %>
          <img src="/assets/images/arcade-moment.jpg" alt="Hariom celebrating his Google Cloud Arcade achievement"
            width="800" height="803" loading="lazy">
          <% } else { %>
            <span class="asset-note">Hariom celebrating his Google Cloud Arcade achievement</span>
            <% } %>
              <figcaption>A milestone worth celebrating.</figcaption>
      </figure>
      <figure>
        <% if (hasAsset("/assets/images/arcade-rewards.jpg")) { %>
          <img src="/assets/images/arcade-rewards.jpg" alt="Google Cloud Arcade rewards displayed alongside a laptop"
            width="1080" height="607" loading="lazy">
          <% } else { %>
            <span class="asset-note">Google Cloud Arcade rewards displayed alongside a laptop</span>
            <% } %>
              <figcaption>Rewards from the Arcade journey.</figcaption>
      </figure>
    </div>
  </div>

  <!-- Apna College C++ DSA certificate -->
  <div class="arcade-achievement apna-achievement reveal" aria-labelledby="apna-title">
    <div class="arcade-copy">
      <p class="eyebrow">Programming · Certification</p>
      <h2 id="apna-title">Apna College</h2>
      <p class="arcade-award">C++ DSA — Certificate of Completion</p>
      <p>Awarded to <strong>Hariom Gupta</strong> for successfully completing the C++ DSA course.</p>
      <div class="tag-list">
        <span>C++</span>
        <span>Data Structures</span>
        <span>Algorithms</span>
      </div>
      <p class="arcade-date">Issued by Apna College · Shradha Khapra, Co-founder</p>
      <a class="button button-primary" href="<%= hasAsset("/assets/certificates/apna-college-cpp-dsa.pdf")
        ? "/assets/certificates/apna-college-cpp-dsa.pdf" : "/assets-help" %>" target="_blank" rel="noopener">View
        certificate <span aria-hidden="true">↗</span>
      </a>
    </div>
    <a class="certificate-preview" href="<%= hasAsset("/assets/certificates/apna-college-cpp-dsa.pdf")
      ? "/assets/certificates/apna-college-cpp-dsa.pdf" : "/assets-help" %>" target="_blank" rel="noopener"
      aria-label="Open Hariom Gupta’s Apna College C++ DSA certificate">
      <% if (hasAsset("/assets/certificates/apna-college-cpp-dsa.png")) { %>
        <img src="/assets/certificates/apna-college-cpp-dsa.png"
          alt="Apna College certificate awarded to Hariom Gupta for completing C++ DSA" loading="lazy">
        <% } else { %>
          <span class="asset-note">Apna College certificate awarded to Hariom Gupta for completing C++ DSA</span>
          <% } %>
    </a>
  </div>


  <div class="arcade-achievement apna-achievement reveal" aria-labelledby="fullstack-title">
    <div class="arcade-copy">
      <p class="eyebrow">Web development · Certification</p>
      <h2 id="fullstack-title">Full Stack Web Development</h2>
      <p class="arcade-award">Delta — Certificate of Completion</p>
      <p>Awarded to <strong>Hariom Kumar</strong> for successfully completing the Delta (Full Stack Web Development) course at Apna College.</p>
      <div class="tag-list"><span>React</span><span>Node.js</span><span>MongoDB</span><span>JavaScript</span></div>
      <p class="arcade-date">Apna College · Shradha Khapra, Co-founder</p>
      <a class="button button-primary" href="/assets/certificates/full-stack-hariom-kumar.png" target="_blank" rel="noopener">View certificate <span aria-hidden="true">↗</span></a>
      <a class="button" href="/assets/certificates/full-stack-hariom-kumar.png" download="Hariom-Kumar-Full-Stack-Certificate.png">Download certificate ↓</a>
    </div>
    <a class="certificate-preview" href="/assets/certificates/full-stack-hariom-kumar.png" target="_blank" rel="noopener" aria-label="Open Hariom Kumar's full stack web development certificate">
      <img src="/assets/certificates/full-stack-hariom-kumar.png" alt="Apna College Delta Full Stack Web Development certificate for Hariom Kumar" width="1504" height="1048" loading="lazy">
    </a>
  </div>

</section>