<!-- Project cards: edit each project in views/projects/ -->
<section class="projects section" id="projects">
  <div class="container">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Projects with a practical point of view.</h2>
      </div>
      <p>Built around real workflows, clear interfaces, and technology chosen for the problem.</p>

    </div>

    <div class="project-grid">
      <%
        const projectOrder = ['zerodha', 'airbnb', 'proconnect'];
        const rank = project => {
          const index = projectOrder.indexOf(project.template || project.id);
          return index === -1 ? projectOrder.length : index;
        };
        const orderedProjects = [...projects].sort((a, b) => rank(a) - rank(b));
      %>
      <% for (const project of orderedProjects) { %>
        <% if (['proconnect','zerodha','airbnb'].includes(project.template) && !project.image) { %>
          <%- include('../projects/' + project.template + '/card', {project}) %>
        <% } else { %>
              <article class="project-card project-content">
                <% if(project.image) { %><img class="project-upload-image" src="<%= project.image %>" alt="<%= project.title %> preview" loading="lazy"><% } %>
                <h3>
                  <%= project.title %>
                </h3>
                <p>
                  <%= project.description %>
                </p>
                <% if (project.url) { %>
                  <a class="project-open" href="<%= project.url %>" target="_blank" rel="noopener noreferrer">View
                    project ↗</a>
                <% } %>
<% if (project.liveUrl) { %>
  <a class="project-live-link" href="<%= project.liveUrl %>" target="_blank" rel="noopener noreferrer">View live project ↗</a>
<% } %>
              </article>
        <% } %>
      <% } %>
    </div>

  </div>
</section>